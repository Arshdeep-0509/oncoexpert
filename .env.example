# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables.

# The appointment form sends each request by email (Resend) and to the Google Sheet, when each is
# set up. Neither set up: the form shows its error message ("Something went wrong. Please call …");
# it never fakes a success.

# Google Sheet: the Web app URL (ends in /exec) of scripts/google-sheets/appointments.gs, and the
# same secret as its WEBHOOK_SECRET script property. Setup: README.md, "Appointment form".
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Resend API key (https://resend.com/api-keys).
RESEND_API_KEY=

# Where appointment requests are emailed. Defaults to info@oncoxpert.in.
APPOINTMENT_TO_EMAIL=info@oncoxpert.in

# Sender address. Must be on a domain verified in Resend (e.g. website@oncoxpert.in).
# The default onboarding@resend.dev can only deliver to the Resend account owner.
APPOINTMENT_FROM_EMAIL="OncoXpert Website <website@oncoxpert.in>"
