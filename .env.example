# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables.

# Resend API key (https://resend.com/api-keys). Without it the appointment form
# shows its error message ("Something went wrong. Please call …"); it never fakes a success.
RESEND_API_KEY=

# Where appointment requests are emailed. Defaults to info@oncoxpert.in.
APPOINTMENT_TO_EMAIL=info@oncoxpert.in

# Sender address. Must be on a domain verified in Resend (e.g. website@oncoxpert.in).
# The default onboarding@resend.dev can only deliver to the Resend account owner.
APPOINTMENT_FROM_EMAIL="OncoXpert Website <website@oncoxpert.in>"
